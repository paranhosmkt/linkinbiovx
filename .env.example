# Resend API Key for automated thank you emails (https://resend.com/api-keys)
RESEND_API_KEY=
# Sender email (e.g. onboarding@resend.dev or seu-nome@seudominio.com.br)
RESEND_FROM_EMAIL=onboarding@resend.dev

# Firebase Configuration (Managed by AI Studio or manual custom deployment)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_DATABASE_ID=

# Gemini API Key (Optional)
GEMINI_API_KEY=



