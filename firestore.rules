rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function incoming() { return request.resource.data; }

    function isValidLead(data) {
      return data.keys().hasAll(['name', 'email', 'createdAt']) &&
             data.keys().hasOnly(['name', 'email', 'optIn', 'source', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.email is string && data.email.size() > 5 && data.email.size() <= 150 &&
             data.email.matches('^.+@.+\\..+$') &&
             (!('optIn' in data) || data.optIn is bool) &&
             (!('source' in data) || (data.source is string && data.source.size() <= 100)) &&
             data.createdAt is timestamp;
    }

    match /leads/{leadId} {
      // Allow inserting leads safely with validation
      allow create: if isValidLead(incoming());
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
