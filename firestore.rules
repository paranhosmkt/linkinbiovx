rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function incoming() { return request.resource.data; }

    function isValidLead(data) {
      return data.keys().hasAll(['name', 'email', 'createdAt']) &&
             data.keys().hasOnly(['name', 'email', 'sector', 'optIn', 'phone', 'productName', 'source', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.email is string && data.email.size() > 5 && data.email.size() <= 150 &&
             data.email.matches('^.+@.+\\..+$') &&
             (!('sector' in data) || data.sector == null || (data.sector is string && data.sector.size() <= 150)) &&
             (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 50)) &&
             (!('productName' in data) || data.productName == null || (data.productName is string && data.productName.size() <= 100)) &&
             (!('optIn' in data) || data.optIn is bool) &&
             (!('source' in data) || data.source == null || (data.source is string && data.source.size() <= 100)) &&
             data.createdAt is timestamp;
    }

    match /leads/{leadId} {
      // Allow inserting leads safely with validation
      allow create: if isValidLead(incoming());
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
